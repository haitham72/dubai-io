# Next.js site — copy to apps/site/.env.local (gitignored).
# API origin for rewrites / Playwright (default matches handoff).
DUBAIIO_API_ORIGIN=http://127.0.0.1:8030

# Browser-facing API base. Leave empty when Next proxies /api/* to the API.
NEXT_PUBLIC_API_BASE=

# Optional Maps JS key for the legacy /app/map page only.
# Interactive Maps in the unified app use GET /api/maps/config from the API.
NEXT_PUBLIC_MAPS_KEY=

# Optional embedded original PWA URL for handoff views
# NEXT_PUBLIC_PWA_URL=http://127.0.0.1:8030/index.html
