# Dubai-io API — copy to apps/api/.env (gitignored).
# This is the only env file FastAPI loads (apps/api/app/config.py).
# Full annotated template also lives at repo-root .env.example.

OPENAI_API_KEY=

GOOGLE_PLACES_KEY=
GOOGLE_MAPS_BROWSER_KEY=

SERPAPI_KEY=
TVLY_API_KEY=
FINNHUB_API_KEY=

NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8030/api/auth/google/callback
OAUTH_TOKEN_KEY=

# VERTEX_PROJECT=
# VERTEX_LOCATION=me-central1
# GOOGLE_APPLICATION_CREDENTIALS=
# DEMO_MAIL=1

# Blank / whitespace => SQLite
DATABASE_URL=

# --- E1/E2/E4 Temporal Memory bridge & Identity ---
MEMORY_BRIDGE_BACKEND=http
TM_BASE_URL=http://localhost:8040
TM_SERVICE_TOKEN=
TM_ADMIN_TOKEN=
TM_TIMEOUT_SECONDS=10.0
TM_CHAT_RUNNER=claude-cli
TM_CHAT_MODEL=claude-haiku-4-5-20251001
IDENTITY_TOKEN_KEY=
IDENTITY_JWT_ISSUER=
IDENTITY_JWT_AUDIENCE=authenticated
IDENTITY_JWT_JWKS_URL=
IDENTITY_JWT_HS256_SECRET=
EXPO_PUBLIC_API_URL=
DUBAI_WEB_URL=http://localhost:8082

# --- Connectors (optional). Tokens stay server-side. See docs/connectors/ ---
# CONNECTOR_TOKEN_KEY=
# Unofficial WhatsApp via a self-hosted Evolution API (Baileys). Default off.
# WHATSAPP_EVOLUTION_ENABLED=0
# EVOLUTION_API_BASE_URL=
# EVOLUTION_API_KEY=
# DATABASE_SCHEMA=dubaiio

WIDGET_PORT=8001
LUNA_EFFORT=low
CELERY_EAGER=1
LLM_PROVIDER=openai
LUNA_MODEL=gpt-6-luna
FAST_MODEL=gpt-6.1-sol
