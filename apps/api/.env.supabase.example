# Copy values into your ignored apps/api/.env, preserving existing provider keys.
# Dedicated local project: npx --yes supabase@2.121.0 start (repository root).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15422/postgres
DATABASE_SCHEMA=dubaiio
# Existing tester cookie ownership remains in use. No Google OAuth required.
# Hosted later: use the dashboard's direct or session-pooler URL with sslmode=require.
# Never put the database password or a service-role key in web/native configuration.
