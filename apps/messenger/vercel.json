{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:name/:id", "destination": "/api/:name?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
