# Copy to .env (never commit .env). The same keys go into the Vercel project's Environment Variables.

# --- Mirsal AI: OpenAI does everything (demo); Nara is the fallback in code ---
# Text chat, contact replies, research briefs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Small model for contacts' auto-replies in normal chats
OPENAI_REPLY_MODEL=gpt-4o-mini
# Streaming transcription, Decisions, TTS, batch transcription (same key, api.openai.com)
# NARA_API_KEY=              # fallback text provider (router) when set
# NARA_BASE_URL=https://router.bynara.id/v1
# NARA_MODEL=agnes-2.5-flash
# NARA_REPLY_MODEL=agnes-2.5-flash
# Voice mode (optional overrides — only served if the chosen endpoint exposes /audio/*)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova

# --- Live data (optional; empty = demo data) ---
SERPAPI_KEY=          # flights
FINNHUB_API_KEY=      # stock quotes
TVLY_API_KEY=         # research web search (Tavily)

# --- Higgs (HTTP API — the CLI can't run on Vercel). Every generation costs credits. ---
# HF_CREDENTIALS=KEY_ID:KEY_SECRET   (or HF_API_KEY_ID + HF_API_KEY_SECRET)
# HIGGS_IMAGE_ENDPOINT=              # Nano Banana 2 endpoint path from Higgs Cloud (empty = fake images)
# HIGGS_VIDEO_ENDPOINT=kling-video/v3.0/std/text-to-video
# 1 = fake image jobs (4s, stock photo, no credits). Use while developing.
MIRSAL_FAKE_IMAGES=1
# 1 = play the bundled Kling clips in media/videos instead of generating (no credits)
MIRSAL_FAKE_VIDEOS=1

# --- Private demo link (production only): visitors need ?key=<DEMO_KEY> once ---
# DEMO_KEY=

# --- Agents service (agents/, Python + Redis, local first; optional — the app falls back when it is off) ---
# Paid calls are opt-in: keys alone never spend. AGENTS_LIVE=1 enables OpenAI (streaming transcription, Decisions,
# research model) and Tavily, under a hard cap.
# AGENTS_LIVE=1
# AGENTS_BUDGET_USD=1.00
# REDIS_URL=redis://localhost:6379/0
# AGENTS_STT_LIVE=1              # opt-in streaming transcription (OpenAI realtime only; off = batch voice path)
# AGENTS_STT_DELAY=medium          # minimal|low|medium|high|xhigh — lower streams sooner, higher waits for steadier words
# AGENTS_STT_COMMIT_MS=0           # >0 commits short segments while speaking, if deltas only arrive after a commit
# AGENTS_UNDO_MS=3000              # undo window before a voice-sent message is final
# AGENTS_WATCH=1                   # refresh the weekly watch topics (agents/watchlist.json)
# AGENTS_VISION_MODEL=             # OpenAI model that reads photos for "@mirsal is this true" (default: the research model)
# GMAIL_CLIENT_FILE=agents/.secrets/gmail_client.json   # OAuth client for the Gmail test account

# --- Outside connectors (all optional; empty = labelled demo data). Status: GET /agents/connectors ---
# DIWAN_MCP_URL=                   # Diwan MCP server (UAE events), tool upcoming_events
# DIWAN_MCP_TOKEN=
# SUPABASE_URL=                    # event pictures: public bucket DIWAN_BUCKET, one folder per event, max 3 used
# SUPABASE_ANON_KEY=
# DIWAN_BUCKET=diwan
# DIWAN_DEMO_DATE=2026-10-07   # demo: pin Diwan's "today" so the Sheikh Rashid event shows as Today
# MIRSAL_BUILDER_MCP_URL=          # Mirsal Builder MCP (sticker packs), tool create_sticker_pack
# MIRSAL_BUILDER_MCP_TOKEN=
# STICKERS_DIR=                    # exported packs folder (default public/stickers)
# NADI_MCP_URL=                    # HR leave MCP, tools file_leave / list_leave
# NADI_MCP_TOKEN=
# GIPHY_API_KEY=
