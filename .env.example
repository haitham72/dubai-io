# Dubai-io (contest) — environment template
# ----------------------------------------
# Secrets: copy this file to the paths below (all gitignored). Never commit real keys.
#
#   apps/api/.env          ← required for FastAPI (apps/api/app/config.py loads ONLY this file)
#   apps/site/.env.local   ← optional for Next.js (see apps/site/.env.example)
#
# Local run (handoff):
#   API  :8030   |  site :3000 (npm run dev)  |  DATABASE_URL blank/space = SQLite

# =============================================================================
# apps/api/.env  — paste into that file
# =============================================================================

# --- Required for Luna chat ---
OPENAI_API_KEY=

# --- Google Places + maps (server key). Interactive map on localhost can fall back to this. ---
GOOGLE_PLACES_KEY=
# Optional: referrer-restricted Maps JavaScript key for production browser maps
GOOGLE_MAPS_BROWSER_KEY=

# --- Live shopping / web search / headlines ---
SERPAPI_KEY=
TVLY_API_KEY=
# Optional market quotes
FINNHUB_API_KEY=

# --- Optional: NaraRouter (social / feed personas) ---
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1

# --- Google OAuth (Me → Connect Google; mail profiler needs Gmail API) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8030/api/auth/google/callback
# Leave empty to auto-create apps/api/data/oauth.key
OAUTH_TOKEN_KEY=

# --- Still-photo try-on (Vertex preferred; otherwise OpenAI image uses OPENAI_API_KEY) ---
# VERTEX_PROJECT=
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=me-central1
# GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_ACCESS_TOKEN=
# DEMO_MAIL=1
# TRYON_FIXTURE=1

# --- Database: blank or whitespace = local SQLite under apps/api/data ---
DATABASE_URL=

# --- Connectors (optional; docs/connectors/). Secrets stay in this file, never in git. ---
# CONNECTOR_TOKEN_KEY=
# WhatsApp is unofficial (Evolution API / Baileys) and stays off until you set all three.
# WHATSAPP_EVOLUTION_ENABLED=0
# EVOLUTION_API_BASE_URL=
# EVOLUTION_API_KEY=
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15422/postgres
# DATABASE_SCHEMA=dubaiio

# --- Runtime ---
WIDGET_PORT=8001
LUNA_EFFORT=high
CELERY_EAGER=1
# OPS_TOKEN=
# MERCHANT_PIN=

# =============================================================================
# apps/site/.env.local  — optional; see apps/site/.env.example
# =============================================================================
# DUBAIIO_API_ORIGIN=http://127.0.0.1:8030
# NEXT_PUBLIC_API_BASE=
# NEXT_PUBLIC_MAPS_KEY=
